# Example environment for @workspace/api-server.
# Copy to `.env` and fill in real values. The real `.env` is gitignored —
# never commit secrets. This file lists the variable NAMES only.

# Core
PORT=
DATABASE_URL=
SESSION_SECRET=
ALLOWED_ORIGIN=
NODE_ENV=
APP_URL=

# Shopify
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_APP_SHARED_SECRET2=

# Email (Resend)
RESEND_API_KEY=

# Planday
PLANDAY_CLIENT_ID=
PLANDAY_REFRESH_TOKEN=

# Anthropic (Recipe Designer / AI features)
ANTHROPIC_API_KEY=

# Govee temperature sensors — developer cloud API (https://developer.govee.com).
# Non-profit use only per Govee terms. Read-only. Leave blank to disable the
# Govee fridge/freezer temperature features.
GOVEE_API_KEY=

# Web Push (VAPID) — for temperature alert notifications to installed PWAs.
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Public key is safe to expose; private key is secret. Leave blank to disable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Zapiet widget API key (read-only; stock-gate Zapiet verification)
ZAPIET_API_KEY=
